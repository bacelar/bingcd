
param int nlimbs=4;

fn new_approx_h
( reg ptr u64[nlimbs] a b
) -> reg u64, reg u64
{
  reg u64 aw, bw, a0, a1, b0, b1, x0, x1, c;
  reg u8 c8;
  reg bool zf;
  inline int k;

  if (0 < nlimbs) {
    a1 = a[nlimbs-1];
    b1 = b[nlimbs-1];
  } else {
    a1 = 0;
    b1 = 0;
  }
  x1 = a1;
  x1 |= b1;

  if (1 < nlimbs) {
    a0 = a[nlimbs-2];
    b0 = b[nlimbs-2];
  } else {
    a0 = 0;
    b0 = 0;
  }
  x0 = x1;
  _, _, _, _, zf, x1 = #AND(x1,x1);
  a1 = a0 if zf;
  b1 = b0 if zf;
  x1 |= a0;
  x1 |= b0;

  for k = nlimbs-3 downto -1 {
    aw = a[k];
    bw = b[k];
    _, _, _, _, zf, x0 = #AND(x0,x0);
    a0 = aw if zf;
    b0 = bw if zf;
    x0 = x1;
    _, _, _, _, zf, x1 = #AND(x1,x1);
    a1 = aw if zf;
    b1 = bw if zf;
    x1 |= aw;
    x1 |= bw;
  }
  // at this point:
  //  a1, b1 are a[k], b[k] where k is the highest limb where a[k]|b[k]<>0
  //  a0, b0 are a[k-1], b[k-1] (or a[k], b[k], when k=0 (x0=0))

  c = a1;  
  c |= b1;
  _, _, _, _, _, c = #LZCNT_64(c);
  c8 = (8u) c;
  c8 &= 63;
  _, _, _, _, _, a1 = #SHLD(a1, a0, c8);
  _, _, _, _, _, b1 = #SHLD(b1, b0, c8);

  return a1, b1;
}

fn approx_h
( reg u64 a0 a1 a2 a3 b0 b1 b2 b3
) -> reg u64, reg u64
{
  reg u64 al, ah, bl, bh, x0, x1, c;
  reg u8 c8;
  reg bool zf;

  // looking at a3, b3
  ah = a3;
  bh = b3;
  x1 = a3;
  x1 |= b3; // x1<>0 if (a3|b3)!=0; a3,b3 DEAD

  // looking at a2, b2
  al = a2;
  bl = b2;
  x0 = x1;
  _, _, _, _, zf, x1 = #AND(x1,x1);
  ah = a2 if zf;
  bh = b2 if zf;
  x1 |= a2; // a2 is dead
  x1 |= b2; // b2 is dead

  // looking at a1, b1
  _, _, _, _, zf, x0 = #AND(x0,x0);
  al = a1 if zf;
  bl = b1 if zf;
  x0 = x1;
  _, _, _, _, zf, x1 = #AND(x1,x1);
  ah = a1 if zf;
  bh = b1 if zf;
  x1 |= a1; // a1 is dead
  x1 |= b1; // b1 is dead

  // looking at a0, b0
  _, _, _, _, zf, x0 = #AND(x0,x0);
  al = a0 if zf;
  bl = b0 if zf;
  _, _, _, _, zf, x1 = #AND(x1,x1);
  ah = a0 if zf;
  bh = b0 if zf;

  // at this point:
  //  a1, b1 are a[k], b[k] where k is the highest limb where a[k]|b[k]<>0
  //  a0, b0 are a[k-1], b[k-1] (or a[k], b[k], when k=0 (x0=0))

  c = ah;  
  c |= bh;
  _, _, _, _, _, c = #LZCNT_64(c);
  // obs: c==64 only if aw==0 => x0==x1==a[i]==b[i]==0
  c8 = (8u) c;
  c8 &= 63;
  _, _, _, _, _, ah = #SHLD(ah, al, c8);
  _, _, _, _, _, bh = #SHLD(bh, bl, c8);

  // low-bits approximation
//  al = a0;
//  bl = b0;

  return ah, bh;
}


fn innerloop_body_opt
( reg u64 a_h b_h a_l b_l
, reg u64 f0 g0 f1 g1
) -> reg u64 /* a_h */
   , reg u64 /* b_h */
   , reg u64 /* a_l */
   , reg u64 /* b_l */
   , reg u64 /* f0 */
   , reg u64 /* f1 */
   , reg u64 /* g0 */
   , reg u64 /* g1 */
{

  reg u64 ta_h, tb_h, ta_l, tb_l;
  reg u64 tf0, tf1, tg0, tg1;
  reg bool cond;

  // Move a, b to ta, tb
  ta_h = a_h;
  tb_h = b_h;
  ta_l = a_l;
  tb_l = b_l;

  // Conditional swap if a < b
  cond = a_h < b_h;
  a_h = tb_h if cond;
  b_h = ta_h if cond;
  a_l = tb_l if cond;
  b_l = ta_l if cond;
  
  // Subtract b to a    
  a_l -= b_l;
  a_h -= b_h;

  // If a was even, undo the subtraction
  _, _, _, _, cond = #TEST(ta_l, 0x01);
  a_h = ta_h if cond;
  b_h = tb_h if cond;
  a_l = ta_l if cond;
  b_l = tb_l if cond;


  // Recompute the swap condition BEFORE loading tf/tg, so ta_h and tb_h die
  // here and their registers can be reused for the tf/tg temporaries. The
  // moves below are register copies and preserve flags, so `cond` stays
  // valid until the cmovs (mirrors the C WIDE_INNER macro).
  cond = ta_h < tb_h;

  // Move f0, f1, g0, g1 into tf0, tf1, tg0, tg1 (mov preserves flags)
  tf0 = f0;
  tf1 = f1;
  tg0 = g0;
  tg1 = g1;

  // Conditional swap if a < b
  f0 = tf1 if cond;
  f1 = tf0 if cond;
  g0 = tg1 if cond;
  g1 = tg0 if cond;

  // Subtract b to a
  f0 -= f1;
  g0 -= g1;

  // If a was even, undo the subtraction
  _, _, _, _, cond = #TEST(ta_l, 0x01);
  f0 = tf0 if cond;
  f1 = tf1 if cond;
  g0 = tg0 if cond;
  g1 = tg1 if cond;

  // Now, a is even: apply shifts
  a_l >>= 1;
  a_h >>= 1;

  f1 += f1;
  g1 += g1;

  return a_h, b_h, a_l, b_l, f0, g0, f1, g1;
}


export fn c_approx
( reg mut ptr u64[4] approx
, reg const ptr u64[4] a b
) -> reg ptr u64[4]
{
  reg u64 a3, a2, a1, a0, b3, b2, b1, b0;
  reg u64 ah, bh;
  a3 = a[3]; a2 = a[2]; a1 = a[1]; a0 = a[0]; 
  b3 = b[3]; b2 = b[2]; b1 = b[1]; b0 = b[0]; 
  ah, bh = approx_h(a3,a2,a1,a0,b3,b2,b1,b0);
  approx[0] = ah;
  approx[1] = a0;
  approx[2] = bh;
  approx[3] = b0;
  return approx;
}

export fn inner
( reg mut ptr u64[8] x
) -> reg ptr u64[8]
{
  reg u64 ah, al, bh, bl;
  reg u64 f0, f1, g0, g1;
  stack u64 c;
  () = #spill(x);
  ah = 1;
  al = 2;
  bh = 3;
  bl = 4;
  f0 = 10;
  f1 = 11;
  g1 = 12;
  g0 = 13;
  // dummy loop
  c = 62;
  while (c != 0) {
    c -=2;
  ah, al, bh, bl, f0, f1, g0, g1
   = innerloop_body_opt(ah, al, bh, bl, f0, f1, g0, g1);
  ah, al, bh, bl, f0, f1, g0, g1
   = innerloop_body_opt(ah, al, bh, bl, f0, f1, g0, g1);
  }
  () = #unspill(x);
  x[0] = ah;
  x[1] = al;
  x[2] = bh;
  x[3] = bl;
  x[4] = f0;
  x[5] = f1;
  x[6] = g0;
  x[7] = g1;
  return x;
}
